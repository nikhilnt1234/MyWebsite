# Server-only secrets (do NOT use NEXT_PUBLIC_ prefix)
# These are used only in Route Handlers / server code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional compatibility keys (if you use existing custom names)
PORTFOLIO_LLM_PROVIDER=openai
PORTFOLIO_LLM_API_KEY=
PORTFOLIO_LLM_MODEL=gpt-4o-mini

# Public env vars (NEXT_PUBLIC_ values are exposed in the browser bundle)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
